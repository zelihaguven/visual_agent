   "ham": "{\"tur\": \"cevap\", \"cevap\": [{\"alintilar\": [{\"kaynak_no\": 1, \"metin\": \"The standard height of the presser foot (1) is 6 mm when the presser foot (1) is raised by means of the lifting lever (2).\"}], \"metin\": \"Kaldırma kolu (lifting lever) (2) ile baskı ayağı (1) kaldırıldığında standart yükseklik 6 mm olmalıdır.\"}, {\"alintilar\": [{\"kaynak_no\": 1, \"metin\": \"Loosen the nut (3), and then turn the adjustment screw (4) so that there is no pressure applied to the presser foot.\"}], \"metin\": \"Somunu (3) gevşetin ve baskı ayağına basınç uygulanmayacak şekilde ayar vidasını (adjustment screw) (4) çevirin.\"}, {\"alintilar\": [{\"kaynak_no\": 1, \"metin\": \"Raise the presser foot (1) by using the lifting lever (2).\"}], \"metin\": \"Kaldırma kolunu (2) kullanarak baskı ayağını (1) kaldırın.\"}, {\"alintilar\": [{\"kaynak_no\": 1, \"metin\": \"Remove the rubber cap (5) from the face plate. Loosen the bolt (6) and then move the presser bar (7) up or down until the presser foot (1) is at the 6\"}], \"metin\": \"Ön plakadan kauçuk kapağı (5) çıkarın, cıvatayı (6) gevşetin ve baskı ayağı (1) 6 mm standart yüksekliğe gelene kadar baskı çubuğunu (presser bar) (7) yukarı veya aşağı hareket ettirin.\"}, {\"alintilar\": [{\"kaynak_no\": 1, \"metin\": \"Tighten the bolt (6). Install the rubber cap (5).\"}], \"metin\": \"Cıvatayı (6) sıkın ve kauçuk kapağı (5) takın.\"}, {\"alintilar\": [{\"kaynak_no\": 1, \"metin\": \"Adjust the presser foot pressure using the presser adjusting screw (4), and then tighten the nut (3).\"}], \"metin\": \"Baskı ayar vidasını (4) kullanarak baskı ayağı basıncını ayarlayın ve ardından somunu (3) sıkın.\"}], \"sesli_metin\": \"Baskı ayağı standart yüksekliği 6 mm olmalıdır. Kaldırma kolu ile ayağı kaldırın, cıvatayı gevşeterek baskı çubuğunu 6 mm yüksekliğe ayarlayın ve ardından somunu sıkın.\", \"celiski_var\": false}",
