   "ham": "{\n \"tur\": \"cevap\",\n \"cevap\": [\n  {\n   \"alintilar\": [\n    {\n     \"kaynak_no\": 1,\n     \"metin\": \"The standard height of the presser foot (1) is 6 mm when the presser foot (1) is raised by means of the lifting lever (2).\"\n    }\n   ],\n   \"metin\": \"Kaldırma kolu (lifting lever) (2) ile baskı ayağı (presser foot) (1) kaldırıldığında standart yükseklik 6 mm'dir.\"\n  },\n  {\n   \"alintilar\": [\n    {\n     \"kaynak_no\": 1,\n     \"metin\": \"Loosen the nut (3), and then turn the adjustment screw (4) so that there is no pressure applied to the presser foot.\"\n    }\n   ],\n   \"metin\": \"Somunu (nut) (3) gevşetin ve ardından baskı ayağına basınç uygulanmayacak şekilde ayar vidasını (adjustment screw) (4) çevirin.\"\n  },\n  {\n   \"alintilar\": [\n    {\n     \"kaynak_no\": 1,\n     \"metin\": \"Raise the presser foot (1) by using the lifting lever (2).\"\n    }\n   ],\n   \"metin\": \"Kaldırma kolunu (lifting lever) (2) kullanarak baskı ayağını (presser foot) (1) kaldırın.\"\n  },\n  {\n   \"alintilar\": [\n    {\n     \"kaynak_no\": 1,\n     \"metin\": \"Remove the rubber cap (5) from the face plate. Loosen the bolt (6) and then move the presser bar (7) up or down until the presser foot (1) is at the 6\"\n    }\n   ],\n   \"metin\": \"Plaka üzerindeki kauçuk kapağı (rubber cap) (5) çıkarın, cıvatayı (bolt) (6) gevşetin ve baskı ayağı (presser foot) (1) 6 mm standart yüksekliğe gelene kadar baskı çubuğunu (presser bar) (7) yukarı veya aşağı hareket ettirin.\"\n  },\n  {\n   \"alintilar\": [\n    {\n     \"kaynak_no\": 1,\n     \"metin\": \"Tighten the bolt (6). Install the rubber cap (5). Adjust the presser foot pressure using the presser adjusting screw (4), and then tighten the nut (3)\"\n    }\n   ],\n   \"metin\": \"Cıvatayı (bolt) (6) sıkın, kauçuk kapağı (rubber cap) (5) takın, baskı ayağı ayar vidasını (presser adjusting screw) (4) kullanarak baskı ayağı basıncını ayarlayın ve ardından somunu (nut) (3) sıkın.\"\n  }\n ],\n \"sesli_metin\": \"Baskı ayağı standart yüksekliği kaldırma kolu ile kaldırıldığında 6 mm olmalıdır."
